# ThreatByte Environment Configuration Template
# Duplicate this file to .env and insert your personal keys

# 1. NVIDIA NIM API Key (Free tier from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# 2. Telegram Bot Configuration (From @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=threatbytebot
TELEGRAM_CHAT_ID=

# 3. Public Web Portal URL (Used in Telegram broadcast links)
SITE_URL=https://yourusername.github.io/hack-dump
